        0.2 * np.sqrt(training_df["var3"]) + 
        np.random.randn(n) * 0.5
    )
    
    # Test hybrid selection
    result = run_pipeline(
        df=training_df,
        target="logit_pd",
        variables=["var1", "var2", "var3"],
        segment_col="segment",
        output_excel="model_output_hybrid.xlsx",
        selection_method='hybrid'  # Can be 'hybrid', 'forward', 'backward', or 'best'
    )

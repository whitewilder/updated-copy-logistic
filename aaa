import * as vscode from 'vscode';
import * as fs from 'fs';
import * as path from 'path';
import { FullAnalysisResult, QualityAudit, StructuralSynthesis, ChunkAnalysis, VisualizationPlan } from './config';

// ──────────── LOGGER ────────────

export class Logger {
  private static channel: vscode.OutputChannel | null = null;

  static init(): vscode.OutputChannel {
    if (!this.channel) {
      this.channel = vscode.window.createOutputChannel('Doc Analyzer RLM');
    }
    return this.channel;
  }

  static info(msg: string): void {
    this.init().appendLine(`[INFO  ${this.ts()}] ${msg}`);
  }

  static warn(msg: string): void {
    this.init().appendLine(`[WARN  ${this.ts()}] ${msg}`);
  }

  static error(msg: string, err?: any): void {
    this.init().appendLine(`[ERROR ${this.ts()}] ${msg}`);
    if (err?.stack) { this.init().appendLine(err.stack); }
  }

  static debug(msg: string): void {
    this.init().appendLine(`[DEBUG ${this.ts()}] ${msg}`);
  }

  private static ts(): string {
    return new Date().toISOString().substring(11, 23);
  }
}

// ──────────── PROGRESS TRACKER ────────────

export class ProgressTracker {
  private currentPercent = 0;

  constructor(
    private reporter?: (msg: string, increment: number) => void,
    private stream?: vscode.ChatResponseStream
  ) {}

  report(message: string, targetPercent: number): void {
    const increment = Math.max(0, targetPercent - this.currentPercent);
    this.currentPercent = targetPercent;
    Logger.info(`[${targetPercent}%] ${message}`);
    this.reporter?.(message, increment);
    this.stream?.progress(message);
  }
}

// ──────────── JSON VALIDATION ────────────

export function extractAndParseJSON<T>(raw: string, fallback: () => T): T {
  // Strip markdown fences
  let cleaned = raw.trim();

  const fenceMatch = cleaned.match(/```(?:json)?\s*\n?([\s\S]*?)\n?\s*```/);
  if (fenceMatch) {
    cleaned = fenceMatch[1].trim();
  }

  // Find outermost JSON object
  const firstBrace = cleaned.indexOf('{');
  if (firstBrace === -1) {
    Logger.warn('No JSON object found in LLM response, using fallback');
    return fallback();
  }

  // Find matching closing brace
  let depth = 0;
  let lastBrace = -1;
  for (let i = firstBrace; i < cleaned.length; i++) {
    if (cleaned[i] === '{') { depth++; }
    if (cleaned[i] === '}') { depth--; if (depth === 0) { lastBrace = i; break; } }
  }

  if (lastBrace === -1) {
    Logger.warn('Unbalanced braces in JSON, attempting repair');
    cleaned = cleaned.substring(firstBrace) + '}'.repeat(depth);
    lastBrace = cleaned.length - 1;
  } else {
    cleaned = cleaned.substring(firstBrace, lastBrace + 1);
  }

  // Repair common issues
  cleaned = cleaned
    .replace(/,\s*([\]}])/g, '$1')           // trailing commas
    .replace(/\n/g, ' ')                       // newlines in strings
    .replace(/[\x00-\x1f]/g, ' ');            // control characters

  try {
    return JSON.parse(cleaned) as T;
  } catch (e1) {
    Logger.warn(`JSON parse attempt 1 failed: ${e1}`);

    // Try fixing unquoted keys
    const repaired = cleaned.replace(/(\{|,)\s*([a-zA-Z_]\w*)\s*:/g, '$1"$2":');
    try {
      return JSON.parse(repaired) as T;
    } catch (e2) {
      Logger.error(`JSON parse failed after repair: ${e2}`);
      return fallback();
    }
  }
}


  synthesis.missing_sections_or_transitions = Array.isArray(synthesis.missing_sections_or_transitions) ? synthesis.missing_sections_or_transitions : [];
  synthesis.recommended_reordering = Array.isArray(synthesis.recommended_reordering) ? synthesis.recommended_reordering : [];


param(
    [Parameter(Mandatory=$true)]
    [string]$Message
)

# 1. Stage all changes
Write-Host "Staging changes..." -ForegroundColor Cyan
git add -A

# 2. Commit with the provided message
Write-Host "Committing..." -ForegroundColor Cyan
git commit -m $Message

if ($LASTEXITCODE -ne 0) {
    Write-Host "Nothing to commit or commit failed. Exiting." -ForegroundColor Yellow
    exit
}

# 3. Pull latest changes via rebase to keep history clean
Write-Host "Pulling latest changes (rebase)..." -ForegroundColor Cyan
git pull --rebase

if ($LASTEXITCODE -ne 0) {
    Write-Host "Conflict detected during pull! Please resolve manually." -ForegroundColor Red
    exit
}

# 4. Push to remote
Write-Host "Pushing to remote..." -ForegroundColor Cyan
git push

if ($LASTEXITCODE -eq 0) {
    Write-Host "Successfully synced!" -ForegroundColor Green
} else {
    Write-Host "Push failed." -ForegroundColor Red
}

import * as vscode from 'vscode';
import {
  PROMPTS, ChunkAnalysis, StructuralSynthesis, QualityAudit,
  VisualizationPlan, FullAnalysisResult, GlobalContextMemory
} from './config';
import { Chunk } from './parser';

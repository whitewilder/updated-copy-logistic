import * as vscode from 'vscode';
import { REPLState, PROMPTS, FullAnalysisResult, GlobalContextMemory } from './config';
import { callLLM } from './llm';
import { Logger } from './utils';

let currentState: REPLState = {
  analysisResult: null,
  conversationHistory: [],
  contextSnapshot: null,
  sessionId: ''
};

/**
 * Initialize REPL with analysis results and context.
 */
export function initREPL(result: FullAnalysisResult, context: GlobalContextMemory): void {
  currentState = {
    analysisResult: result,
    conversationHistory: [],
    contextSnapshot: context,
    sessionId: `repl_${Date.now()}`
  };
  Logger.info(`REPL session initialized: ${currentState.sessionId}`);
}

export function isREPLActive(): boolean {
  return currentState.analysisResult !== null;
}

/**
 * Process a REPL query against the analysis results.
 * Maintains full conversation history for context retention.
 */
export async function processREPLQuery(
  query: string,
  token: vscode.CancellationToken
): Promise<string> {
  if (!currentState.analysisResult) {
    return '❌ No analysis loaded. Run `@docrlm /analyze` first to analyze a document.';
  }

  const result = currentState.analysisResult;

  // Build analysis context summary for LLM
  const analysisContext = buildREPLContext(result);

  // Build conversation history (last 10 turns to prevent token overflow)
  const recentHistory = currentState.conversationHistory.slice(-10);
  const historyStr = recentHistory.length > 0
    ? `\nCONVERSATION HISTORY:\n${recentHistory.map(h => `${h.role.toUpperCase()}: ${h.content}`).join('\n')}\n`
    : '';

  const userPrompt = `${analysisContext}
${historyStr}
USER QUERY: ${query}

Respond thoroughly, citing specific chunks, sections, scores, and issues from the analysis. If the user asks for a rewrite, clearly separate original from proposed text.`;

  try {
    const response = await callLLM(PROMPTS.REPL_SYSTEM, userPrompt, token);

    // Update conversation history
    currentState.conversationHistory.push(
      { role: 'user', content: query },
      { role: 'assistant', content: response }
    );

    return response;
  } catch (err: any) {
    Logger.error('REPL query failed', err);
    return `❌ Error processing query: ${err.message}`;
  }
}

/**
 * Builds a compressed analysis context string for REPL queries.
 */
function buildREPLContext(result: FullAnalysisResult): string {
  const qa = result.layer3_quality_audit;
  const ss = result.layer2_structural_synthesis;

  const parts: string[] = [
    `DOCUMENT ANALYSIS CONTEXT:`,
    `File: ${result.metadata.filename} | Chunks: ${result.metadata.total_chunks} | Chars: ${result.metadata.total_characters}`,
    ``,
    `SCORES: Sanity=${qa.sanity_score}/100, Readability=${qa.readability_score}/100, Completeness=${qa.completeness_score}/100`,
    `FLOW: ${ss.global_flow_assessment} | Arc: ${ss.narrative_arc} | Audience: ${ss.audience_alignment}`,
    ``,
    `DOCUMENT OUTLINE:`,
    ...ss.document_outline.map(s => `  [${s.weight}] ${s.section} (${s.role}) chunks ${s.chunk_range[0]+1}-${s.chunk_range[1]+1} ${s.issues.length > 0 ? '⚠' + s.issues.length : '✅'}`),
    ``,
    `CHUNK SUMMARIES:`
  ];

  for (const ca of result.layer1_chunk_analyses) {
    const issueStr = ca.issues_detected.length > 0
      ? ` | Issues: ${ca.issues_detected.map(i => `[${i.severity}/${i.type}]${i.description.substring(0,60)}`).join('; ')}`
      : '';
    parts.push(`  Chunk ${ca.chunk_index+1} [${ca.narrative_role}]: ${ca.chunk_summary.substring(0, 200)}${issueStr}`);
  }

  if (qa.priority_fixes.length > 0) {
    parts.push(`\nPRIORITY FIXES: ${qa.priority_fixes.join(' | ')}`);
  }
  if (qa.strengths.length > 0) {
    parts.push(`STRENGTHS: ${qa.strengths.join(' | ')}`);
  }
  if (qa.flow_breaks.length > 0) {
    parts.push(`FLOW BREAKS: ${qa.flow_breaks.map(fb => `[${fb.severity}]${fb.location}:${fb.reason}`).join(' | ')}`);
  }
  if (qa.story_gaps.length > 0) {
    parts.push(`STORY GAPS: ${qa.story_gaps.join(' | ')}`);
  }
  if (result.layer4_visualization_plan.visual_recommendations.length > 0) {
    parts.push(`VIZ RECS: ${result.layer4_visualization_plan.visual_recommendations.map(v => `${v.type}@${v.location}`).join(', ')}`);
  }

  if (Object.keys(result.cross_reference_map).length > 0) {
    parts.push(`\nCROSS-REFS: ${Object.entries(result.cross_reference_map).slice(0, 15).map(([k,v]) => `"${k}"→${v.join(',')}`).join(' | ')}`);
  }

  return parts.join('\n');
}

/**
 * Run interactive REPL in VS Code QuickInput.
 */
export async function runInteractiveREPL(): Promise<void> {
  if (!isREPLActive()) {
    vscode.window.showWarningMessage('No analysis loaded. Run analysis first.');
    return;
  }

  const tokenSource = new vscode.CancellationTokenSource();

  while (true) {
    const query = await vscode.window.showInputBox({
      prompt: '🔄 REPL Query (type "exit" to quit)',
      placeHolder: 'Ask about the analysis: "What are the critical issues?" / "Rewrite section 3" / "Compare chunk 2 and 5"',
      ignoreFocusOut: true
    });

    if (!query || query.toLowerCase() === 'exit' || query.toLowerCase() === 'quit') {
      vscode.window.showInformationMessage('REPL session ended.');
      break;
    }

    const response = await vscode.window.withProgress(
      { location: vscode.ProgressLocation.Notification, title: 'REPL: Processing...', cancellable: true },
      async (_, cancelToken) => {
        return processREPLQuery(query, cancelToken);
      }
    );

    // Show response in output channel
    const channel = Logger.init();
    channel.appendLine(`\n${'─'.repeat(60)}`);
    channel.appendLine(`REPL Q: ${query}`);
    channel.appendLine(`${'─'.repeat(60)}`);
    channel.appendLine(response);
    channel.show(true);
  }

  tokenSource.dispose();
}

): Promise<string> {
  const model = await getModel();

  // Combine into single user message (Copilot API)
  const messages = [
    vscode.LanguageModelChatMessage.User(
      `<SYSTEM_INSTRUCTIONS>\n${systemPrompt}\n</SYSTEM_INSTRUCTIONS>\n\n<USER_REQUEST>\n${userPrompt}\n</USER_REQUEST>`
    )
  ];

  for (let attempt = 0; attempt < MAX_RETRIES; attempt++) {
    if (token.isCancellationRequested) {
      throw new Error('Cancelled by user.');
    }

    try {
      const response = await model.sendRequest(messages, {}, token);
      let fullText = '';
      for await (const chunk of response.text) {
        fullText += chunk;
        if (token.isCancellationRequested) {
          throw new Error('Cancelled by user.');
        }
      }
      return fullText.trim();
    } catch (err: any) {
      if (err.message === 'Cancelled by user.') { throw err; }

      Logger.warn(`LLM call attempt ${attempt + 1} failed: ${err.message}`);

      if (err instanceof vscode.LanguageModelError) {
        if (err.code === 'rate_limited' || err.code === 'model_busy' || err.code === 'quota_exceeded') {
          const delay = RETRY_DELAY_BASE_MS * Math.pow(2, attempt);
          Logger.info(`Rate limited, waiting ${delay}ms...`);
          await sleep(delay);
          continue;
        }
      }

      if (attempt === MAX_RETRIES - 1) {
        throw new Error(`LLM call failed after ${MAX_RETRIES} attempts: ${err.message}`);
      }

      await sleep(RETRY_DELAY_BASE_MS * (attempt + 1));
    }
  }

  throw new Error('LLM call exhausted all retries.');
}

/**
 * Call LLM and parse response as JSON with fallback.
 */
export async function callLLMForJSON<T>(
  systemPrompt: string,
  userPrompt: string,
  token: vscode.CancellationToken,
  fallback: () => T
): Promise<T> {
  const raw = await callLLM(systemPrompt, userPrompt, token);
  return extractAndParseJSON<T>(raw, fallback);
}

function sleep(ms: number): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, ms));
}

import { GlobalContextMemory, ChunkAnalysis, TermInconsistency } from './config';
import { Logger } from './utils';

/**
 * Creates initial empty global context.
 */
export function createInitialContext(): GlobalContextMemory {
  return {
    document_objective: '',
    target_audience: '',
    document_type: '',
    key_themes: [],
    entities: [],
    running_summary: '',
    chunk_summaries: [],
    terminology_registry: new Map(),
    unresolved_threads: [],
    assumptions_made: [],
    section_boundaries: []
  };
}

/**
 * Updates global context after a chunk analysis.
 * This is the core mechanism that prevents context collapse:
 * each chunk's analysis feeds into an ever-growing context memory
 * that is passed to the next chunk.
 */
export function updateContext(
  ctx: GlobalContextMemory,
  analysis: ChunkAnalysis,
  chunkIndex: number
): GlobalContextMemory {
  // Clone to avoid mutation
  const updated: GlobalContextMemory = {
    ...ctx,
    key_themes: [...ctx.key_themes],
    entities: [...ctx.entities],
    chunk_summaries: [...ctx.chunk_summaries],
    terminology_registry: new Map(ctx.terminology_registry),
    unresolved_threads: [...ctx.unresolved_threads],
    assumptions_made: [...ctx.assumptions_made],
    section_boundaries: [...ctx.section_boundaries]
  };

  // Accumulate chunk summary
  updated.chunk_summaries.push(analysis.chunk_summary);

  // Update running summary from LLM
  if (analysis.updated_global_context) {
    updated.running_summary = analysis.updated_global_context;
  }

  // Merge new concepts into themes (deduplicated)
  for (const concept of analysis.new_concepts_introduced) {
    const normalized = concept.toLowerCase().trim();
    if (!updated.key_themes.some(t => t.toLowerCase() === normalized)) {
      updated.key_themes.push(concept);
    }
  }

  // Track unresolved references
  if (analysis.unresolved_references) {
    for (const ref of analysis.unresolved_references) {
      if (!updated.unresolved_threads.includes(ref)) {
        updated.unresolved_threads.push(ref);
      }
    }
  }

  // Resolve references that were unresolved but now addressed
  if (analysis.new_concepts_introduced.length > 0) {
    updated.unresolved_threads = updated.unresolved_threads.filter(thread => {
      const resolved = analysis.new_concepts_introduced.some(c =>
        c.toLowerCase().includes(thread.toLowerCase()) ||
        thread.toLowerCase().includes(c.toLowerCase())
      );
      if (resolved) {
        Logger.debug(`Resolved thread: "${thread}" at chunk ${chunkIndex}`);
      }
      return !resolved;
    });
  }

  // Detect section boundaries from narrative role transitions
  if (chunkIndex > 0) {
    const prevRole = updated.chunk_summaries.length > 1 ? 'continuation' : 'introduction';
    if (analysis.narrative_role === 'introduction' || analysis.narrative_role === 'bridge') {
      updated.section_boundaries.push(chunkIndex);
    }
  }

  // Infer document objective from first chunk
  if (chunkIndex === 0 && !updated.document_objective) {
    updated.document_objective = analysis.chunk_summary;
  }

  return updated;
}

/**
 * Builds a compressed context string for LLM consumption.
 * Limits size to prevent token overflow while preserving critical information.
 */
export function compressContextForLLM(ctx: GlobalContextMemory, maxChars: number = 4000): string {
  const parts: string[] = [];

  if (ctx.document_objective) {
    parts.push(`OBJECTIVE: ${ctx.document_objective}`);
  }
  if (ctx.target_audience) {
    parts.push(`AUDIENCE: ${ctx.target_audience}`);
  }
  if (ctx.key_themes.length > 0) {
    parts.push(`THEMES: ${ctx.key_themes.slice(-20).join(', ')}`);
  }
  if (ctx.unresolved_threads.length > 0) {
    parts.push(`UNRESOLVED: ${ctx.unresolved_threads.join(', ')}`);
  }
  if (ctx.running_summary) {
    parts.push(`RUNNING SUMMARY: ${ctx.running_summary}`);
  }

  // Add recent chunk summaries (most important for continuity)
  const recentSummaries = ctx.chunk_summaries.slice(-5);
  if (recentSummaries.length > 0) {
    parts.push(`RECENT SECTIONS:\n${recentSummaries.map((s, i) =>
      `  [Chunk ${ctx.chunk_summaries.length - recentSummaries.length + i + 1}]: ${s}`
    ).join('\n')}`);
  }

  let result = parts.join('\n');
  if (result.length > maxChars) {
    result = result.substring(0, maxChars - 100) + '\n[...context truncated for token limits...]';
  }

  return result;
}

/**
 * Builds cross-reference map from all chunk analyses.
 */
export function buildCrossReferenceMap(
  analyses: ChunkAnalysis[]
): Record<string, string[]> {
  const conceptMap: Record<string, string[]> = {};

  for (const ca of analyses) {
    for (const concept of ca.new_concepts_introduced) {
      const key = concept.toLowerCase().trim();
      if (!conceptMap[key]) {
        conceptMap[key] = [];
      }
      conceptMap[key].push(`Chunk ${ca.chunk_index + 1}`);
    }

    // Also check dependencies
    for (const dep of ca.dependencies_on_previous_sections) {
      const key = dep.toLowerCase().trim();
      if (!conceptMap[key]) {
        conceptMap[key] = [];
      }
      if (!conceptMap[key].includes(`Chunk ${ca.chunk_index + 1} (ref)`)) {
        conceptMap[key].push(`Chunk ${ca.chunk_index + 1} (ref)`);
      }
    }
  }

  // Filter to concepts appearing in multiple chunks (actual cross-references)
  const crossRefs: Record<string, string[]> = {};
  for (const [concept, locations] of Object.entries(conceptMap)) {
    if (locations.length >= 2) {
      crossRefs[concept] = locations;
    }
  }

  return crossRefs;
}

export async function writeTextReport(result: FullAnalysisResult, outputDir: string): Promise<string> {
  const filePath = path.join(outputDir, `analysis_${sanitizeFilename(result.metadata.filename)}_${Date.now()}.txt`);
  const lines: string[] = [];

  lines.push('=' .repeat(80));
  lines.push('DOCUMENT ANALYSIS REPORT');
  lines.push('='.repeat(80));
  lines.push('');
  lines.push(`File:           ${result.metadata.filename}`);
  lines.push(`Chunks:         ${result.metadata.total_chunks}`);
  lines.push(`Characters:     ${result.metadata.total_characters.toLocaleString()}`);
  lines.push(`Model:          ${result.metadata.model_used}`);
  lines.push(`Analyzed:       ${result.metadata.analyzed_at}`);
  lines.push(`Processing:     ${(result.metadata.processing_time_ms / 1000).toFixed(1)}s`);
  lines.push('');

  // Scores
  lines.push('-'.repeat(80));
  lines.push('SCORES');
  lines.push('-'.repeat(80));
  const qa = result.layer3_quality_audit;
  lines.push(`Sanity Score:       ${qa.sanity_score}/100  ${scoreBar(qa.sanity_score)}`);
  lines.push(`Readability Score:  ${qa.readability_score}/100  ${scoreBar(qa.readability_score)}`);
  lines.push(`Completeness Score: ${qa.completeness_score}/100  ${scoreBar(qa.completeness_score)}`);
  lines.push(`Flow Assessment:    ${result.layer2_structural_synthesis.global_flow_assessment}`);
  lines.push('');

  // Executive Summary
  lines.push('-'.repeat(80));
  lines.push('EXECUTIVE SUMMARY');
  lines.push('-'.repeat(80));
  lines.push(result.executive_summary);
  lines.push('');

  // Document Outline
  lines.push('-'.repeat(80));
  lines.push('DOCUMENT STRUCTURE');
  lines.push('-'.repeat(80));
  const ss = result.layer2_structural_synthesis;
  lines.push(`Narrative Arc: ${ss.narrative_arc}`);
  lines.push(`Audience Alignment: ${ss.audience_alignment}`);
  lines.push('');
  for (const sec of ss.document_outline) {
    const weightTag = sec.weight === 'balanced' ? '  ' : sec.weight === 'overweight' ? '++' : '--';
    lines.push(`  [${weightTag}] ${sec.section} (${sec.role}) [Chunks ${sec.chunk_range[0]+1}-${sec.chunk_range[1]+1}]`);
    for (const iss of sec.issues) {
      lines.push(`       ⚠ ${iss}`);
    }
  }
  lines.push('');

  if (ss.key_structural_issues.length > 0) {
    lines.push('Key Structural Issues:');
    ss.key_structural_issues.forEach((i, idx) => lines.push(`  ${idx+1}. ${i}`));
    lines.push('');
  }

  if (ss.missing_sections_or_transitions.length > 0) {
    lines.push('Missing Sections/Transitions:');
    ss.missing_sections_or_transitions.forEach(m => lines.push(`  • ${m}`));
    lines.push('');
  }

  if (ss.recommended_reordering.length > 0) {
    lines.push('Recommended Reordering:');
    ss.recommended_reordering.forEach(r => lines.push(`  [${r.priority.toUpperCase()}] Move "${r.from}" → "${r.to}": ${r.reason}`));
    lines.push('');
  }

  // Quality Audit
  lines.push('-'.repeat(80));
  lines.push('QUALITY AUDIT');
  lines.push('-'.repeat(80));

  if (qa.strengths.length > 0) {
    lines.push('Strengths:');
    qa.strengths.forEach(s => lines.push(`  ✓ ${s}`));
    lines.push('');
  }

  if (qa.priority_fixes.length > 0) {
    lines.push('Priority Fixes:');
    qa.priority_fixes.forEach((f, i) => lines.push(`  ${i+1}. ${f}`));
    lines.push('');
  }

  if (qa.flow_breaks.length > 0) {
    lines.push('Flow Breaks:');
    qa.flow_breaks.forEach(fb => lines.push(`  [${fb.severity.toUpperCase()}] ${fb.location}: ${fb.reason}`));
    lines.push('');
  }

  if (qa.story_gaps.length > 0) {
    lines.push('Story Gaps:');
    qa.story_gaps.forEach(g => lines.push(`  ○ ${g}`));
    lines.push('');
  }

  if (qa.terminology_inconsistencies.length > 0) {
    lines.push('Terminology Inconsistencies:');
    qa.terminology_inconsistencies.forEach(t => {
      lines.push(`  Variants: ${t.term_variants.join(' / ')} → Recommended: "${t.recommended}"`);
    });
    lines.push('');
  }

  if (qa.reader_confusion_risk_areas.length > 0) {
    lines.push('Reader Confusion Risk:');
    qa.reader_confusion_risk_areas.forEach(r => lines.push(`  ⚠ ${r}`));
    lines.push('');
  }

  // Chunk Analyses
  lines.push('-'.repeat(80));
  lines.push('CHUNK-LEVEL ANALYSIS');
  lines.push('-'.repeat(80));
  for (const ca of result.layer1_chunk_analyses) {
    lines.push(`\n--- Chunk ${ca.chunk_index + 1}/${ca.total_chunks} [${ca.narrative_role}] ---`);
    lines.push(ca.chunk_summary);
    if (ca.tone_shift && ca.tone_shift !== 'none') {
      lines.push(`  Tone Shift: ${ca.tone_shift}`);
    }
    if (ca.issues_detected.length > 0) {
      lines.push('  Issues:');
      ca.issues_detected.forEach(iss => {
        lines.push(`    [${iss.severity.toUpperCase()}/${iss.type}] ${iss.description}`);
        if (iss.suggestion) { lines.push(`      → ${iss.suggestion}`); }
      });
    }
    if (ca.new_concepts_introduced.length > 0) {
      lines.push(`  New Concepts: ${ca.new_concepts_introduced.join(', ')}`);
    }
    if (ca.unresolved_references.length > 0) {
      lines.push(`  Unresolved References: ${ca.unresolved_references.join(', ')}`);
    }
  }
  lines.push('');

  // Visualization
  if (result.layer4_visualization_plan.visual_recommendations.length > 0) {
    lines.push('-'.repeat(80));
    lines.push('VISUALIZATION RECOMMENDATIONS');
    lines.push('-'.repeat(80));
    result.layer4_visualization_plan.visual_recommendations.forEach((v, i) => {
      lines.push(`\n  ${i+1}. ${v.type} at "${v.location}" [${v.priority.toUpperCase()}]`);
      lines.push(`     Purpose: ${v.purpose}`);
      lines.push(`     Data: ${v.data_fields.join(', ')}`);
      lines.push(`     Answers: ${v.story_supported}`);
    });
    lines.push('');
  }

  // Cross-references
  if (Object.keys(result.cross_reference_map).length > 0) {
    lines.push('-'.repeat(80));
    lines.push('CROSS-REFERENCE MAP');
    lines.push('-'.repeat(80));
    for (const [concept, refs] of Object.entries(result.cross_reference_map)) {
      lines.push(`  "${concept}" → appears in: ${refs.join(', ')}`);
    }
    lines.push('');
  }

  lines.push('='.repeat(80));
  lines.push('END OF REPORT');
  lines.push('='.repeat(80));

  const content = lines.join('\n');
  fs.writeFileSync(filePath, content, 'utf-8');
  Logger.info(`Text report written: ${filePath}`);
  return filePath;
}

export async function writeExcelReport(result: FullAnalysisResult, outputDir: string): Promise<string> {
  const ExcelJS = require('exceljs');
  const filePath = path.join(outputDir, `analysis_${sanitizeFilename(result.metadata.filename)}_${Date.now()}.xlsx`);

  const workbook = new ExcelJS.Workbook();
  workbook.creator = 'Doc Analyzer RLM';
  workbook.created = new Date();

  // ── Sheet 1: Overview ──
  const overviewSheet = workbook.addWorksheet('Overview', { properties: { tabColor: { argb: '4472C4' } } });
  overviewSheet.columns = [
    { header: 'Property', key: 'prop', width: 30 },
    { header: 'Value', key: 'val', width: 60 }
  ];
  styleHeader(overviewSheet);
  overviewSheet.addRow({ prop: 'Filename', val: result.metadata.filename });
  overviewSheet.addRow({ prop: 'Total Chunks', val: result.metadata.total_chunks });
  overviewSheet.addRow({ prop: 'Total Characters', val: result.metadata.total_characters.toLocaleString() });
  overviewSheet.addRow({ prop: 'Model Used', val: result.metadata.model_used });
  overviewSheet.addRow({ prop: 'Analyzed At', val: result.metadata.analyzed_at });
  overviewSheet.addRow({ prop: 'Processing Time', val: `${(result.metadata.processing_time_ms / 1000).toFixed(1)}s` });
  overviewSheet.addRow({ prop: '', val: '' });
  overviewSheet.addRow({ prop: 'Sanity Score', val: result.layer3_quality_audit.sanity_score });
  overviewSheet.addRow({ prop: 'Readability Score', val: result.layer3_quality_audit.readability_score });
  overviewSheet.addRow({ prop: 'Completeness Score', val: result.layer3_quality_audit.completeness_score });
  overviewSheet.addRow({ prop: 'Flow Assessment', val: result.layer2_structural_synthesis.global_flow_assessment });
  overviewSheet.addRow({ prop: 'Narrative Arc', val: result.layer2_structural_synthesis.narrative_arc });
  overviewSheet.addRow({ prop: 'Audience Alignment', val: result.layer2_structural_synthesis.audience_alignment });
  overviewSheet.addRow({ prop: '', val: '' });
  overviewSheet.addRow({ prop: 'Executive Summary', val: result.executive_summary });

  // Color-code scores

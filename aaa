  // Command: Analyze Word Document
  // ══════════════════════════════════════════
  const analyzeCmd = vscode.commands.registerCommand('docAnalyzer.analyze', async (uri?: vscode.Uri) => {
    const filePath = await resolveFilePath(uri);
    if (!filePath) { return; }

    await executeAnalysis(filePath, context);
  });

  // ══════════════════════════════════════════
  // Command: Open REPL Session
  // ══════════════════════════════════════════
  const replCmd = vscode.commands.registerCommand('docAnalyzer.repl', async () => {
    if (!isREPLActive()) {
      const choice = await vscode.window.showWarningMessage(
        'No analysis loaded. Analyze a document first?',
        'Analyze Now', 'Cancel'
      );
      if (choice === 'Analyze Now') {
        const filePath = await resolveFilePath();
        if (filePath) { await executeAnalysis(filePath, context); }
      }
      return;
    }
    await runInteractiveREPL();
  });


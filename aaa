      document_outline: chunkAnalyses.map((ca, i) => ({
        section: `Section ${i + 1}`, role: ca.narrative_role,
        weight: 'balanced' as const, issues: ca.issues_detected.map(is => is.description),
        chunk_range: [i, i] as [number, number]
      })),
      global_flow_assessment: 'Moderate' as const,
      key_structural_issues: [],
      missing_sections_or_transitions: [],
      recommended_reordering: [],
      narrative_arc: 'Linear',

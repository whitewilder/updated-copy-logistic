  // ═══════════════════════════════════════════
  // LAYER 3: Quality Audit
  // ═══════════════════════════════════════════
  progress.report('Layer 3: Quality audit...', 62);

  const auditPrompt = `STRUCTURAL SYNTHESIS:
${JSON.stringify(synthesis, null, 2)}

CHUNK ISSUES SUMMARY:
${JSON.stringify(chunkAnalyses.map(ca => ({
    chunk: ca.chunk_index + 1, role: ca.narrative_role,
    issues: ca.issues_detected, summary: ca.chunk_summary.substring(0, 200),
    unresolved: ca.unresolved_references
  })), null, 2)}

UNRESOLVED THREADS: ${globalContext.unresolved_threads.join(', ') || 'none'}
ALL THEMES: ${globalContext.key_themes.join(', ')}

Perform comprehensive quality audit. Output ONLY valid JSON.`;

  const audit = await callLLMForJSON<QualityAudit>(
    PROMPTS.LAYER3_AUDIT,
    auditPrompt,
    token,
    () => ({
      sanity_score: 50, readability_score: 50, completeness_score: 50,
      flow_breaks: [], story_gaps: [], terminology_inconsistencies: [],
      reader_confusion_risk_areas: [], strengths: [], priority_fixes: []
    })
  );

  // Normalize
  audit.sanity_score = clampScore(audit.sanity_score);
  audit.readability_score = clampScore(audit.readability_score);
  audit.completeness_score = clampScore(audit.completeness_score);
  audit.flow_breaks = Array.isArray(audit.flow_breaks) ? audit.flow_breaks : [];
  audit.story_gaps = Array.isArray(audit.story_gaps) ? audit.story_gaps : [];
  audit.terminology_inconsistencies = Array.isArray(audit.terminology_inconsistencies) ? audit.terminology_inconsistencies : [];
  audit.reader_confusion_risk_areas = Array.isArray(audit.reader_confusion_risk_areas) ? audit.reader_confusion_risk_areas : [];
  audit.strengths = Array.isArray(audit.strengths) ? audit.strengths : [];
  audit.priority_fixes = Array.isArray(audit.priority_fixes) ? audit.priority_fixes : [];

  Logger.info(`Layer 3: sanity=${audit.sanity_score}, readability=${audit.readability_score}, completeness=${audit.completeness_score}`);

  // ═══════════════════════════════════════════
  // LAYER 4: Visualization Recommendations
  // ═══════════════════════════════════════════
  progress.report('Layer 4: Visualization recommendations...', 78);

  const vizPrompt = `DOCUMENT OUTLINE:
${JSON.stringify(synthesis.document_outline, null, 2)}

CONTENT SUMMARIES:
${JSON.stringify(chunkAnalyses.map(ca => ({
    chunk: ca.chunk_index + 1, summary: ca.chunk_summary.substring(0, 150),
    concepts: ca.new_concepts_introduced
  })), null, 2)}

DOCUMENT OBJECTIVE: ${globalContext.document_objective}

Recommend visualizations. Output ONLY valid JSON.`;

  const vizPlan = await callLLMForJSON<VisualizationPlan>(
    PROMPTS.LAYER4_VISUAL,
    vizPrompt,
    token,
    () => ({ visual_recommendations: [] })
  );
  vizPlan.visual_recommendations = Array.isArray(vizPlan.visual_recommendations) ? vizPlan.visual_recommendations : [];

  Logger.info(`Layer 4: ${vizPlan.visual_recommendations.length} visualization recommendations`);

  // ═══════════════════════════════════════════
  // Executive Summary
  // ═══════════════════════════════════════════
  progress.report('Generating executive summary...', 90);

  let execSummary: string;
  try {
    execSummary = await callLLM(
      PROMPTS.EXECUTIVE_SUMMARY,
      `SCORES: Sanity=${audit.sanity_score}, Readability=${audit.readability_score}, Completeness=${audit.completeness_score}
FLOW: ${synthesis.global_flow_assessment}
SECTIONS: ${synthesis.document_outline.length}
TOTAL ISSUES: ${chunkAnalyses.reduce((s, c) => s + c.issues_detected.length, 0)}
STRUCTURAL ISSUES: ${synthesis.key_structural_issues.join('; ')}
STRENGTHS: ${audit.strengths.join('; ')}
PRIORITY FIXES: ${audit.priority_fixes.join('; ')}
STORY GAPS: ${audit.story_gaps.join('; ')}
DOCUMENT OBJECTIVE: ${globalContext.document_objective}
NARRATIVE ARC: ${synthesis.narrative_arc}

Write the executive summary. Plain text only.`,
      token
    );
  } catch {
    execSummary = `Analysis complete. Sanity: ${audit.sanity_score}/100, Flow: ${synthesis.global_flow_assessment}. ${audit.priority_fixes.length} priority fixes identified.`;
  }

  // Build cross-reference map
  const crossRefs = buildCrossReferenceMap(chunkAnalyses);

  const processingTime = Date.now() - startTime;
  progress.report('Analysis complete!', 100);

  const result: FullAnalysisResult = {
    metadata: {
      filename,
      total_chunks: chunks.length,
      total_characters: totalChars,
      analyzed_at: new Date().toISOString(),
      model_used: getModelName(),
      processing_time_ms: processingTime
    },
    layer1_chunk_analyses: chunkAnalyses,
    layer2_structural_synthesis: synthesis,
    layer3_quality_audit: audit,
    layer4_visualization_plan: vizPlan,
    executive_summary: execSummary,
    cross_reference_map: crossRefs
  };

  return { result, context: globalContext };
}

function clampScore(val: any): number {
  const n = typeof val === 'number' ? val : 50;
  return Math.max(0, Math.min(100, Math.round(n)));
}

// ============================================================
// parser.ts — Word document parsing + smart chunking
// ============================================================

import * as fs from 'fs';
import * as path from 'path';
import { MAX_CHUNK_TOKENS, OVERLAP_TOKENS } from './config';
import { Logger } from './utils';

export interface ParsedDocument {
  text: string;
  filename: string;
  sizeBytes: number;
  characterCount: number;
}

export interface Chunk {
  index: number;
  total: number;
  text: string;
  startOffset: number;
  endOffset: number;
  estimatedTokens: number;
}

/**
 * Parse a .docx file and extract raw text.
 */
export async function parseWordDocument(filePath: string): Promise<ParsedDocument> {
  const ext = path.extname(filePath).toLowerCase();
  if (ext !== '.docx' && ext !== '.doc') {
    throw new Error(`Invalid file type: "${ext}". Only .docx/.doc files are accepted.`);
  }

  if (!fs.existsSync(filePath)) {
    throw new Error(`File not found: ${filePath}`);
  }

  const stats = fs.statSync(filePath);
  if (stats.size === 0) {
    throw new Error('File is empty (0 bytes).');
  }

  Logger.info(`Parsing: ${filePath} (${(stats.size / 1024).toFixed(1)} KB)`);

  const mammoth = require('mammoth');
  const buffer = fs.readFileSync(filePath);

  let result: { value: string; messages: any[] };
  try {
    result = await mammoth.extractRawText({ buffer });
  } catch (err: any) {
    throw new Error(`Failed to parse Word document: ${err.message}`);
  }

  const text = result.value.trim();
  if (text.length < 20) {
    throw new Error('Document contains insufficient text content (< 20 characters).');
  }

  if (result.messages.length > 0) {
    Logger.warn(`Parser warnings: ${result.messages.map((m: any) => m.message).join('; ')}`);
  }

  Logger.info(`Parsed successfully: ${text.length} characters`);

  return {
    text,
    filename: path.basename(filePath),
    sizeBytes: stats.size,
    characterCount: text.length
  };
}

/**
 * Smart chunking with paragraph-aware boundaries and overlapping context.
 * Detects section headers and prefers splitting at section boundaries.
 */
export function chunkDocument(
  text: string,
  maxTokens: number = MAX_CHUNK_TOKENS,
  overlapTokens: number = OVERLAP_TOKENS
): Chunk[] {
  const maxChars = maxTokens * 4;
  const overlapChars = overlapTokens * 4;

  if (text.length <= maxChars) {
    Logger.info('Document fits in single chunk');
    return [{
      index: 0, total: 1, text, startOffset: 0,
      endOffset: text.length, estimatedTokens: Math.ceil(text.length / 4)
    }];
  }

  // Split on double-newlines (paragraphs) or section-like headers
  const paragraphs = text.split(/\n\s*\n/);
  const chunks: Chunk[] = [];
  let currentParagraphs: string[] = [];
  let currentLen = 0;
  let startOffset = 0;
  let runningOffset = 0;

  for (let i = 0; i < paragraphs.length; i++) {
    const para = paragraphs[i].trim();
    if (!para) {
      runningOffset += paragraphs[i].length + 2;
      continue;
    }

    const isHeader = /^(?:#{1,6}\s|[A-Z][A-Z\s]{3,}$|\d+\.\s+[A-Z])/.test(para);

    // Split conditions: over size OR hit a header with enough content
    const shouldSplit = (currentLen + para.length > maxChars && currentParagraphs.length > 0) ||
                        (isHeader && currentLen > maxChars * 0.4 && currentParagraphs.length > 2);

    if (shouldSplit) {
      const chunkText = currentParagraphs.join('\n\n');
      chunks.push({
        index: chunks.length, total: 0, text: chunkText,
        startOffset, endOffset: startOffset + chunkText.length,
        estimatedTokens: Math.ceil(chunkText.length / 4)
      });

      // Overlap: carry last paragraphs
      const overlapParas: string[] = [];
      let oLen = 0;
      for (let j = currentParagraphs.length - 1; j >= 0; j--) {
        if (oLen + currentParagraphs[j].length > overlapChars) { break; }
        overlapParas.unshift(currentParagraphs[j]);
        oLen += currentParagraphs[j].length;
      }

      currentParagraphs = [...overlapParas];
      currentLen = oLen;
      startOffset = runningOffset - oLen;
    }

    currentParagraphs.push(para);
    currentLen += para.length;
    runningOffset += paragraphs[i].length + 2;
  }

  // Final chunk
  if (currentParagraphs.length > 0) {
    const chunkText = currentParagraphs.join('\n\n');
    chunks.push({
      index: chunks.length, total: 0, text: chunkText,
      startOffset, endOffset: startOffset + chunkText.length,
      estimatedTokens: Math.ceil(chunkText.length / 4)
    });
  }

  // Set totals
  const total = chunks.length;
  chunks.forEach(c => c.total = total);

  Logger.info(`Chunked into ${total} chunks (avg ~${Math.round(text.length / total / 4)} tokens each)`);
  return chunks;
}

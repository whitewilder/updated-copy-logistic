/**
 * Main RLM Pipeline: 4 layers of recursive, context-preserving analysis.
 */
export async function runRLMPipeline(
  chunks: Chunk[],
  filename: string,
  totalChars: number,
  token: vscode.CancellationToken,
  progress: ProgressTracker
): Promise<{ result: FullAnalysisResult; context: GlobalContextMemory }> {
  const startTime = Date.now();

  // ═══════════════════════════════════════════
  // LAYER 1: Recursive Chunk Analysis
  // ═══════════════════════════════════════════
  progress.report('Layer 1: Beginning recursive chunk analysis...', 2);
  let globalContext = createInitialContext();
  const chunkAnalyses: ChunkAnalysis[] = [];
  let previousSummary = '';

  for (let i = 0; i < chunks.length; i++) {
    if (token.isCancellationRequested) { throw new Error('Cancelled.'); }

    progress.report(
      `Layer 1: Chunk ${i + 1}/${chunks.length} (${chunks[i].estimatedTokens} tokens)...`,
      2 + (i / chunks.length) * 38
    );

    const compressedCtx = compressContextForLLM(globalContext);

    const userPrompt = `CHUNK ${i + 1} OF ${chunks.length}

GLOBAL CONTEXT MEMORY:
${compressedCtx}

PREVIOUS CHUNK SUMMARY:
${previousSummary || '(First chunk — no previous context)'}

CURRENT CHUNK TEXT:
---
${chunks[i].text.substring(0, 7000)}
---

Analyze this chunk. Output ONLY valid JSON, no other text.`;

    const analysis = await callLLMForJSON<ChunkAnalysis>(
      PROMPTS.LAYER1_CHUNK,
      userPrompt,
      token,
      () => ({
        chunk_index: i,
        total_chunks: chunks.length,
        chunk_summary: `Chunk ${i + 1} content.`,
        narrative_role: 'continuation' as const,
        issues_detected: [],
        dependencies_on_previous_sections: [],
        new_concepts_introduced: [],
        unresolved_references: [],
        tone_shift: 'none',
        updated_global_context: globalContext.running_summary
      })
    );

    // Normalize
    analysis.chunk_index = i;
    analysis.total_chunks = chunks.length;
    analysis.issues_detected = Array.isArray(analysis.issues_detected) ? analysis.issues_detected : [];
    analysis.new_concepts_introduced = Array.isArray(analysis.new_concepts_introduced) ? analysis.new_concepts_introduced : [];
    analysis.dependencies_on_previous_sections = Array.isArray(analysis.dependencies_on_previous_sections) ? analysis.dependencies_on_previous_sections : [];
    analysis.unresolved_references = Array.isArray(analysis.unresolved_references) ? analysis.unresolved_references : [];

    chunkAnalyses.push(analysis);

    // UPDATE GLOBAL CONTEXT (prevents context collapse)
    previousSummary = analysis.chunk_summary;
    globalContext = updateContext(globalContext, analysis, i);

    Logger.info(`Chunk ${i+1}: role=${analysis.narrative_role}, issues=${analysis.issues_detected.length}, concepts=${analysis.new_concepts_introduced.length}`);
  }

  // ═══════════════════════════════════════════
  // LAYER 2: Structural Synthesis
  // ═══════════════════════════════════════════
  progress.report('Layer 2: Structural synthesis...', 45);

  const synthesisSummaries = chunkAnalyses.map(ca => ({
    chunk: ca.chunk_index + 1,
    summary: ca.chunk_summary,
    role: ca.narrative_role,
    issues_count: ca.issues_detected.length,
    concepts: ca.new_concepts_introduced,

async function executeAnalysis(
  filePath: string,
  context: vscode.ExtensionContext,
  stream?: vscode.ChatResponseStream
): Promise<FullAnalysisResult | null> {
  return vscode.window.withProgress(
    {
      location: stream ? vscode.ProgressLocation.Notification : vscode.ProgressLocation.Notification,
      title: 'Doc Analyzer RLM',
      cancellable: true
    },
    async (progress, token) => {
      try {
        const tracker = new ProgressTracker(
          (msg, inc) => progress.report({ message: msg, increment: inc }),
          stream
        );

        // Parse
        tracker.report('Parsing Word document...', 1);
        stream?.markdown(`📂 **Parsing:** \`${path.basename(filePath)}\`\n\n`);

        const parsed = await parseWordDocument(filePath);
        stream?.markdown(`✅ **Parsed:** ${parsed.filename} — ${parsed.characterCount.toLocaleString()} characters (${(parsed.sizeBytes/1024).toFixed(1)} KB)\n\n`);

        // Chunk
        tracker.report('Smart chunking...', 3);
        const chunks = chunkDocument(parsed.text);
        stream?.markdown(`🧩 **Chunked:** ${chunks.length} chunks with overlapping context\n\n`);
        stream?.markdown(`---\n\n⏳ **Running 4-Layer RLM Pipeline...**\n\n`);

        // Run pipeline
        const { result, context: globalCtx } = await runRLMPipeline(
          chunks, parsed.filename, parsed.characterCount, token, tracker
        );

        // Initialize REPL with results
        initREPL(result, globalCtx);
        lastAnalysisResult = result;

        // Generate output files
        const outputDir = path.dirname(filePath);

        tracker.report('Writing text report...', 96);
        const txtPath = await writeTextReport(result, outputDir);

        tracker.report('Writing Excel report...', 98);
        const xlsxPath = await writeExcelReport(result, outputDir);

        tracker.report('Done!', 100);

        // Show in chat
        if (stream) {
          const md = renderMarkdown(result);
          stream.markdown(md);
          stream.markdown(`\n\n---\n`);
          stream.markdown(`📝 **Text Report:** \`${path.basename(txtPath)}\`\n`);
          stream.markdown(`📊 **Excel Report:** \`${path.basename(xlsxPath)}\`\n`);
          stream.markdown(`🔄 **REPL Ready:** Ask follow-up questions with \`@docrlm <question>\`\n`);
        }

        // Open text report
        const doc = await vscode.workspace.openTextDocument(txtPath);
        await vscode.window.showTextDocument(doc, vscode.ViewColumn.Beside);

        vscode.window.showInformationMessage(
          `Analysis complete! Score: ${result.layer3_quality_audit.sanity_score}/100. Reports saved.`,
          'Open Excel'
        ).then(choice => {
          if (choice === 'Open Excel') {
            vscode.env.openExternal(vscode.Uri.file(xlsxPath));
          }
        });

        return result;

      } catch (err: any) {
        const msg = err.message || 'Unknown error';
        Logger.error('Analysis failed', err);
        stream?.markdown(`\n\n❌ **Error:** ${msg}\n`);
        vscode.window.showErrorMessage(`Analysis failed: ${msg}`);
        return null;
      }
    }
  );
}

// ══════════════════════════════════════════
// Chat Handlers
// ══════════════════════════════════════════

async function handleChatAnalyze(
  request: vscode.ChatRequest,
  stream: vscode.ChatResponseStream,
  token: vscode.CancellationToken,
  context: vscode.ExtensionContext
): Promise<vscode.ChatResult> {
  // Try to find file path in prompt
  let filePath: string | undefined;
  const pathMatch = request.prompt.match(/(?:["']?)([a-zA-Z]:\\[^\s"']+\.docx?|\/[^\s"']+\.docx?)(?:["']?)/i);
  if (pathMatch) {
    filePath = pathMatch[1];
  }

  if (!filePath) {
    stream.markdown('📂 Select a Word document...\n\n');
    const uris = await vscode.window.showOpenDialog({
      canSelectFiles: true, canSelectFolders: false, canSelectMany: false,
      filters: { 'Word Documents': ['docx', 'doc'] },
      title: 'Select Word Document'
    });
    if (!uris || uris.length === 0) {
      stream.markdown('❌ No file selected.\n');
      return { metadata: { command: 'analyze' } };
    }
    filePath = uris[0].fsPath;
  }

  await executeAnalysis(filePath, context, stream);
  return { metadata: { command: 'analyze' } };
}

async function handleChatREPL(
  request: vscode.ChatRequest,
  stream: vscode.ChatResponseStream,
  token: vscode.CancellationToken
): Promise<vscode.ChatResult> {
  if (!isREPLActive()) {
    stream.markdown('❌ No analysis loaded. Use `@docrlm /analyze` first.\n');
    return { metadata: { command: 'repl' } };
  }

  const query = request.prompt.trim();
  if (!query) {
    stream.markdown('🔄 **REPL Active.** Ask any question about the analysis:\n\n');
    stream.markdown('Examples:\n');
    stream.markdown('- "What are the critical issues?"\n');
    stream.markdown('- "Explain the score breakdown"\n');
    stream.markdown('- "Compare section 1 and section 3"\n');
    stream.markdown('- "Suggest a rewrite for the introduction"\n');
    stream.markdown('- "What visualizations would help?"\n');
    return { metadata: { command: 'repl' } };
  }

  stream.progress('Processing REPL query...');
  const response = await processREPLQuery(query, token);
  stream.markdown(response);

  return { metadata: { command: 'repl' } };
}

// ══════════════════════════════════════════
// File Resolution
// ══════════════════════════════════════════

async function resolveFilePath(uri?: vscode.Uri): Promise<string | undefined> {
  if (uri) { return uri.fsPath; }

  const editor = vscode.window.activeTextEditor;
  if (editor) {
    const fname = editor.document.fileName;
    if (fname.endsWith('.docx') || fname.endsWith('.doc')) {
      return fname;
    }
  }

  const uris = await vscode.window.showOpenDialog({
    canSelectFiles: true, canSelectFolders: false, canSelectMany: false,
    filters: { 'Word Documents': ['docx', 'doc'] },
    title: 'Select Word Document to Analyze'
  });

  return uris?.[0]?.fsPath;
}

export function deactivate() {
  Logger.info('Document Analyzer RLM Advanced — deactivated');

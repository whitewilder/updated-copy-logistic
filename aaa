  const synthesisPrompt = `CHUNK ANALYSES:
${JSON.stringify(synthesisSummaries, null, 2)}

GLOBAL CONTEXT:
${compressContextForLLM(globalContext)}

DOCUMENT OBJECTIVE: ${globalContext.document_objective}
SECTION BOUNDARIES DETECTED AT CHUNKS: ${globalContext.section_boundaries.join(', ') || 'none'}

Synthesize into structural overview. Output ONLY valid JSON.`;

  const synthesis = await callLLMForJSON<StructuralSynthesis>(
    PROMPTS.LAYER2_SYNTHESIS,

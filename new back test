# Optimized helper functions
@st.cache_data
def generate_dummy_data(n_records=10000):
    """Generate dummy data for testing"""
    np.random.seed(42)
    
    # Generate dates
    start_date = datetime(2023, 1, 1)
    end_date = datetime(2024, 12, 31)
    dates = pd.date_range(start=start_date, end=end_date, periods=n_records)
    
    # Create dummy dataframe
    df = pd.DataFrame({
        'cohort_date_sas': dates,
        'cohort_year': dates.year * 100 + dates.quarter,
        'region': np.random.choice(['North', 'South', 'East', 'West'], n_records),
        'L1_industry_groups': np.random.choice(['Tech', 'Finance', 'Healthcare', 'Retail'], n_records),
        'intodef_gid': np.random.binomial(1, 0.05, n_records),  # 5% default rate
        'pre_moc_mid_point_pd': np.random.beta(2, 20, n_records),  # PD values
        'Model_PD': np.random.beta(2, 20, n_records),
        'score': np.random.uniform(0, 1, n_records)
    })
    
    # Add mid_point_pd column
    df['mid_point_pd'] = df['pre_moc_mid_point_pd']
    
    return df

@st.cache_data
def significance_test_optimized(target_counts, aucroc, limit_sigma=3):
    """Optimized AUC significance test"""
    n_pos, n_neg = target_counts[1], target_counts[0]
    sigma = math.sqrt((n_pos + n_neg + 1) / (12 * n_pos * n_neg))
    upper_limit = 0.5 + limit_sigma * sigma
    test_result = "SIGNIFICANT" if upper_limit < aucroc else "NOT SIGNIFICANT"
    return test_result, upper_limit

@st.cache_data
def calculate_auc_gini(df, score_col, target_col, ascending=False):
    """Calculate AUC and GINI efficiently"""
    df_sorted = df.sort_values(score_col, ascending=ascending)
    
    n_pos = df_sorted[target_col].sum()
    n_neg = len(df_sorted) - n_pos
    
    if n_pos == 0 or n_neg == 0:
        return {'AUROC': 0.5, 'gini': 0, 'AR': 0}
    
    tpr = np.cumsum(df_sorted[target_col]) / n_pos
    fpr = np.cumsum(1 - df_sorted[target_col]) / n_neg
    
    auc = np.trapz(tpr, fpr)
    gini = 2 * auc - 1
    ar = 2 * gini
    
    return {'AUROC': auc, 'gini': gini, 'AR': ar}

@st.cache_data
def get_discriminatory_report_optimized(df, group_field, target, score):
    """Optimized discriminatory report generation"""
    results = []
    
    for group_val in df[group_field].unique():
        group_df = df[df[group_field] == group_val]
        
        # Quick AUC check for direction
        metrics = calculate_auc_gini(group_df, score, target, ascending=False)
        if metrics['AUROC'] < 0.5:
            metrics = calculate_auc_gini(group_df, score, target, ascending=True)
            direction = 'inversely_related'
        else:
            direction = 'directly_related'
        
        # Significance test
        target_counts = group_df[target].value_counts()
        sig_test, _ = significance_test_optimized(target_counts, metrics['AUROC'])
        
        results.append({
            group_field: group_val,
            'GINI': metrics['gini'],
            'AUROC': metrics['AUROC'],
            'AR': metrics['AR'],
            '# Observations': len(group_df),
            '# Defaults': int(group_df[target].sum()),
            'Significance': sig_test,
            'Direction': direction
        })
    
    return pd.DataFrame(results)

def create_elegant_table(df, title=""):
    """Create an elegant table visualization"""
    fig, ax = plt.subplots(figsize=(12, len(df) * 0.5 + 2))
    ax.axis('tight')
    ax.axis('off')
    
    # Create table with custom colors
    table = ax.table(cellText=df.values,
                     colLabels=df.columns,
                     cellLoc='center',
                     loc='center')
    
    # Style the table
    table.auto_set_font_size(False)
    table.set_fontsize(9)
    table.scale(1.2, 1.5)
    
    # Color scheme
    for i in range(len(df.columns)):
        table[(0, i)].set_facecolor('#8B0000')
        table[(0, i)].set_text_props(weight='bold', color='white')
    
    for i in range(1, len(df) + 1):
        for j in range(len(df.columns)):
            if i % 2 == 0:
                table[(i, j)].set_facecolor('#f0f0f0')
            else:
                table[(i, j)].set_facecolor('white')
    
    plt.title(title, fontsize=14, fontweight='bold', pad=20)
    return fig

def create_summary_plots(df_list, titles, main_title="Summary"):
    """Create summary plots with gray-red theme"""
    n_plots = len(df_list)
    n_cols = 2
    n_rows = math.ceil(n_plots / n_cols)
    
    fig, axes = plt.subplots(n_rows, n_cols, figsize=(15, 5 * n_rows))
    axes = axes.flatten() if n_plots > 1 else [axes]
    
    # Set style
    plt.style.use('seaborn-v0_8-darkgrid')
    
    for idx, (df, title) in enumerate(zip(df_list, titles)):
        if idx < len(axes):
            ax1 = axes[idx]
            
            # Bar plot for observations
            ax1.bar(df.index, df['Observations'], color='lightgray', alpha=0.7, edgecolor='darkgray')
            ax1.set_ylabel('# Observations', fontsize=10)
            ax1.set_title(title, fontsize=12, fontweight='bold')
            ax1.tick_params(axis='x', rotation=45)
            
            # Line plots for rates
            ax2 = ax1.twinx()
            if 'Default_Rate %' in df.columns:
                ax2.plot(df.index, df['Default_Rate %'], 'o-', color='#8B0000', linewidth=2, label='Default Rate %')
            if 'Avg_PD %' in df.columns:
                ax2.plot(df.index, df['Avg_PD %'], 's-', color='#A52A2A', linewidth=2, label='Avg PD %')
            
            ax2.set_ylabel('Rate (%)', fontsize=10)
            ax2.legend(loc='upper right')
    
    # Hide empty subplots
    for idx in range(n_plots, len(axes)):
        axes[idx].set_visible(False)
    
    plt.suptitle(main_title, fontsize=16, fontweight='bold')
    plt.tight_layout()
    return fig


        # Plot horizontal lines
        for hline_name, color in hline.items():
            if hline_name in df.columns:
                ax2.axhline(y=df[hline_name].iloc[0], color=color, 
                           linestyle='--', linewidth=2, label=hline_name, alpha=0.7)
        

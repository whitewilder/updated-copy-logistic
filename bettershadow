class RegulatoryModelFramework:
    """
    Base class for regulatory model development framework
    """
    def __init__(self, data, target_col, feature_cols, test_size=0.3, random_state=42):
        self.data = data.copy()
        self.target_col = target_col
        self.feature_cols = feature_cols
        self.test_size = test_size
        self.random_state = random_state
        self.model = None
        self.best_features = None
        self.performance_metrics = {}
        self.assumption_tests = {}
        
    def prepare_data(self):
        """Prepare data for modeling"""
        # Remove missing values
        self.data = self.data.dropna(subset=[self.target_col] + self.feature_cols)
        
        # Split data
        X = self.data[self.feature_cols]
        y = self.data[self.target_col]
        
        self.X_train, self.X_test, self.y_train, self.y_test = train_test_split(
            X, y, test_size=self.test_size, random_state=self.random_state
        )
        
        logging.info(f"Data prepared: Train size = {len(self.X_train)}, Test size = {len(self.X_test)}")
        
    def check_multicollinearity(self, X, threshold=10):
        """Check VIF for multicollinearity"""
        X_with_const = sm.add_constant(X)
        vif_data = pd.DataFrame()
        vif_data["Variable"] = X_with_const.columns
        vif_data["VIF"] = [variance_inflation_factor(X_with_const.values, i) 
                          for i in range(X_with_const.shape[1])]
        
        # Remove high VIF variables (except constant)
        high_vif_vars = vif_data[
            (vif_data["VIF"] > threshold) & (vif_data["Variable"] != "const")
        ]["Variable"].tolist()
        
        return vif_data, high_vif_vars
    
    def remove_outliers_iqr(self, X, y, multiplier=1.5):
        """Remove outliers using IQR method"""
        Q1 = X.quantile(0.25)
        Q3 = X.quantile(0.75)
        IQR = Q3 - Q1
        
        outlier_mask = ~((X < (Q1 - multiplier * IQR)) | (X > (Q3 + multiplier * IQR))).any(axis=1)
        
        return X[outlier_mask], y[outlier_mask]
    
    def generate_report(self, filename):
        """Generate comprehensive model report"""
        report = f"""
        REGULATORY MODEL DEVELOPMENT REPORT
        =====================================
        
        Model Type: {self.__class__.__name__}
        Target Variable: {self.target_col}
        
        1. FEATURE SELECTION
        --------------------
        Initial Features: {len(self.feature_cols)}
        Selected Features: {len(self.best_features)}
        Final Features: {', '.join(self.best_features)}
        
        2. ASSUMPTION TESTS
        -------------------
        """
        
        for test, result in self.assumption_tests.items():
            report += f"\n{test}:\n{result}\n"
        
        report += f"""
        3. MODEL PERFORMANCE
        --------------------
        """
        
        for metric, value in self.performance_metrics.items():
            report += f"{metric}: {value:.4f}\n"
        
        # Save report
        with open(filename, 'w') as f:
            f.write(report)
        
        logging.info(f"Report saved to {filename}")
        
        return report


class ShadowRatingModel(RegulatoryModelFramework):
    """
    Shadow Rating Model using Linear Regression
    Target: mid_pt_pd (continuous)
    """
    
    def check_linear_regression_assumptions(self, X, y, model):
        """Check all linear regression assumptions"""
        assumptions = {}
        
        # Get residuals and fitted values
        residuals = model.resid
        fitted_values = model.fittedvalues
        
        # 1. Linearity - Check using residual plots
        assumptions['Linearity'] = "Check residual plots for patterns"
        
        # 2. Normality of residuals - Jarque-Bera test
        jb_stat, jb_pvalue = stats.jarque_bera(residuals)
        assumptions['Normality_JB'] = {
            'statistic': jb_stat,
            'p_value': jb_pvalue,
            'passed': jb_pvalue > 0.05
        }
        
        # Shapiro-Wilk test (for smaller samples)
        if len(residuals) < 5000:
            sw_stat, sw_pvalue = stats.shapiro(residuals)
            assumptions['Normality_SW'] = {
                'statistic': sw_stat,
                'p_value': sw_pvalue,
                'passed': sw_pvalue > 0.05
            }
        
        # 3. Homoscedasticity - Breusch-Pagan test
        bp_stat, bp_pvalue, _, _ = het_breuschpagan(residuals, X)
        assumptions['Homoscedasticity'] = {
            'statistic': bp_stat,
            'p_value': bp_pvalue,
            'passed': bp_pvalue > 0.05
        }
        
        # 4. No autocorrelation - Durbin-Watson test
        dw_stat = durbin_watson(residuals)
        assumptions['No_Autocorrelation'] = {
            'statistic': dw_stat,
            'interpretation': 'Values close to 2 indicate no autocorrelation'
        }
        
        # 5. Multicollinearity - Already checked in feature selection
        
        return assumptions
    
    def stepwise_selection(self, X, y, threshold_in=0.05, threshold_out=0.10):
        """Forward-backward stepwise selection"""
        included = []
        X_const = sm.add_constant(X)
        
        while True:
            changed = False
            
            # Forward step
            excluded = list(set(X.columns) - set(included))
            new_pval = pd.Series(index=excluded, dtype=float)
            
            for new_column in excluded:
                model = sm.OLS(y, X_const[['const'] + included + [new_column]]).fit()
                new_pval[new_column] = model.pvalues[new_column]
            
            best_pval = new_pval.min()
            if best_pval < threshold_in:
                best_feature = new_pval.idxmin()
                included.append(best_feature)
                changed = True
            
            # Backward step
            model = sm.OLS(y, X_const[['const'] + included]).fit()
            pvalues = model.pvalues.iloc[1:]  # Exclude constant
            worst_pval = pvalues.max()
            
            if worst_pval > threshold_out:
                changed = True
                worst_feature = pvalues.idxmax()
                included.remove(worst_feature)
            
            if not changed:
                break
        
        return included
    
    def build_model(self):
        """Build linear regression model with all checks"""
        self.prepare_data()
        
        # Remove outliers
        X_train_clean, y_train_clean = self.remove_outliers_iqr(self.X_train, self.y_train)
        
        # Check multicollinearity and remove high VIF variables
        vif_data, high_vif_vars = self.check_multicollinearity(X_train_clean)
        X_train_clean = X_train_clean.drop(columns=high_vif_vars)
        self.X_test = self.X_test.drop(columns=high_vif_vars)
        
        logging.info(f"Removed {len(high_vif_vars)} high VIF variables: {high_vif_vars}")
        
        # Stepwise selection
        self.best_features = self.stepwise_selection(X_train_clean, y_train_clean)
        logging.info(f"Selected {len(self.best_features)} features through stepwise selection")
        
        # Build final model
        X_train_final = sm.add_constant(X_train_clean[self.best_features])
        self.model = sm.OLS(y_train_clean, X_train_final).fit()
        
        # Check assumptions
        self.assumption_tests = self.check_linear_regression_assumptions(
            X_train_final, y_train_clean, self.model
        )
        
        # Calculate performance metrics
        self.calculate_performance_metrics()
        
        return self.model
    
    def calculate_performance_metrics(self):
        """Calculate regression performance metrics"""
        # Training metrics
        self.performance_metrics['R_squared'] = self.model.rsquared
        self.performance_metrics['Adj_R_squared'] = self.model.rsquared_adj
        self.performance_metrics['AIC'] = self.model.aic
        self.performance_metrics['BIC'] = self.model.bic
        
        # Test set predictions
        X_test_final = sm.add_constant(self.X_test[self.best_features])
        y_pred = self.model.predict(X_test_final)
        
        # Test metrics
        residuals = self.y_test - y_pred
        self.performance_metrics['RMSE'] = np.sqrt(np.mean(residuals**2))
        self.performance_metrics['MAE'] = np.mean(np.abs(residuals))
        self.performance_metrics['MAPE'] = np.mean(np.abs(residuals / self.y_test)) * 100
        
        # R-squared on test set
        ss_res = np.sum(residuals**2)
        ss_tot = np.sum((self.y_test - np.mean(self.y_test))**2)
        self.performance_metrics['Test_R_squared'] = 1 - (ss_res / ss_tot)
    
    def plot_diagnostics(self):
        """Create diagnostic plots"""
        fig, axes = plt.subplots(2, 2, figsize=(12, 10))
        
        # Residuals vs Fitted
        axes[0, 0].scatter(self.model.fittedvalues, self.model.resid, alpha=0.5)
        axes[0, 0].axhline(y=0, color='r', linestyle='--')
        axes[0, 0].set_xlabel('Fitted Values')
        axes[0, 0].set_ylabel('Residuals')
        axes[0, 0].set_title('Residuals vs Fitted')
        
        # Q-Q plot
        stats.probplot(self.model.resid, dist="norm", plot=axes[0, 1])
        axes[0, 1].set_title('Q-Q Plot')
        
        # Scale-Location
        axes[1, 0].scatter(self.model.fittedvalues, np.sqrt(np.abs(self.model.resid)), alpha=0.5)
        axes[1, 0].set_xlabel('Fitted Values')
        axes[1, 0].set_ylabel('√|Residuals|')
        axes[1, 0].set_title('Scale-Location')
        
        # Residuals histogram
        axes[1, 1].hist(self.model.resid, bins=30, edgecolor='black')
        axes[1, 1].set_xlabel('Residuals')
        axes[1, 1].set_ylabel('Frequency')
        axes[1, 1].set_title('Residuals Distribution')
        
        plt.tight_layout()
        plt.savefig('shadow_rating_diagnostics.png')
        plt.close()


class DefaultPredictionModel(RegulatoryModelFramework):
    """
    Default Prediction Model using Logistic Regression
    Target: default (binary)
    """
    
    def check_logistic_regression_assumptions(self, X, y, model):
        """Check logistic regression assumptions"""
        assumptions = {}
        
        # 1. Linearity of logit - Check using Box-Tidwell test
        # For simplicity, we'll check residual deviance
        assumptions['Model_Fit'] = {
            'Pseudo_R_squared': model.prsquared,
            'Log_Likelihood': model.llf,
            'AIC': model.aic,
            'BIC': model.bic
        }
        
        # 2. No multicollinearity - Already checked
        
        # 3. Independence of observations
        assumptions['Sample_Size'] = {
            'n_observations': len(y),
            'n_events': sum(y),
            'event_rate': sum(y) / len(y),
            'min_events_per_variable': sum(y) / len(X.columns)
        }
        
        # 4. Large sample size - Rule of thumb: 10 events per variable
        epv = sum(y) / len(X.columns)
        assumptions['Events_Per_Variable'] = {
            'value': epv,
            'passed': epv >= 10
        }
        
        return assumptions
    
    def backward_elimination(self, X, y, significance_level=0.05):
        """Backward elimination for feature selection"""
        features = list(X.columns)
        
        while len(features) > 0:
            X_with_const = sm.add_constant(X[features])
            model = sm.Logit(y, X_with_const).fit(disp=0)
            
            # Get p-values excluding constant
            p_values = model.pvalues.iloc[1:]
            max_p_value = p_values.max()
            
            if max_p_value > significance_level:
                excluded_feature = p_values.idxmax()
                features.remove(excluded_feature)
                logging.info(f"Removed feature: {excluded_feature} (p-value: {max_p_value:.4f})")
            else:
                break
        
        return features
    
    def build_model(self):
        """Build logistic regression model with all checks"""
        self.prepare_data()
        
        # Check class balance
        class_balance = self.y_train.value_counts(normalize=True)
        logging.info(f"Class balance in training: {class_balance.to_dict()}")
        
        # Check multicollinearity
        vif_data, high_vif_vars = self.check_multicollinearity(self.X_train)
        X_train_clean = self.X_train.drop(columns=high_vif_vars)
        self.X_test = self.X_test.drop(columns=high_vif_vars)
        
        # Feature selection using backward elimination
        # Feature selection using backward elimination
        self.best_features = self.backward_elimination(X_train_clean, self.y_train)
        logging.info(f"Selected {len(self.best_features)} features through backward elimination")
        
        # Build final model
        X_train_final = sm.add_constant(X_train_clean[self.best_features])
        self.model = sm.Logit(self.y_train, X_train_final).fit()
        
        # Check assumptions
        self.assumption_tests = self.check_logistic_regression_assumptions(
            X_train_final, self.y_train, self.model
        )
        
        # Calculate performance metrics
        self.calculate_performance_metrics()
        
        return self.model
    
    def calculate_performance_metrics(self):
        """Calculate classification performance metrics"""
        # Training metrics
        self.performance_metrics['Pseudo_R_squared'] = self.model.prsquared
        self.performance_metrics['Log_Likelihood'] = self.model.llf
        self.performance_metrics['AIC'] = self.model.aic
        self.performance_metrics['BIC'] = self.model.bic
        
        # Test set predictions
        X_test_final = sm.add_constant(self.X_test[self.best_features])
        y_pred_proba = self.model.predict(X_test_final)
        y_pred = (y_pred_proba >= 0.5).astype(int)
        
        # Confusion matrix metrics
        tp = np.sum((y_pred == 1) & (self.y_test == 1))
        tn = np.sum((y_pred == 0) & (self.y_test == 0))
        fp = np.sum((y_pred == 1) & (self.y_test == 0))
        fn = np.sum((y_pred == 0) & (self.y_test == 1))
        
        # Performance metrics
        self.performance_metrics['Accuracy'] = (tp + tn) / (tp + tn + fp + fn)
        self.performance_metrics['Precision'] = tp / (tp + fp) if (tp + fp) > 0 else 0
        self.performance_metrics['Recall'] = tp / (tp + fn) if (tp + fn) > 0 else 0
        self.performance_metrics['F1_Score'] = 2 * (self.performance_metrics['Precision'] * self.performance_metrics['Recall']) / \
                                               (self.performance_metrics['Precision'] + self.performance_metrics['Recall']) \
                                               if (self.performance_metrics['Precision'] + self.performance_metrics['Recall']) > 0 else 0
        
        # Calculate AUC using manual implementation
        self.performance_metrics['AUC'] = self.calculate_auc_manual(self.y_test, y_pred_proba)
        
        # Gini coefficient
        self.performance_metrics['Gini'] = 2 * self.performance_metrics['AUC'] - 1
        
        # Brier score
        self.performance_metrics['Brier_Score'] = np.mean((y_pred_proba - self.y_test)**2)
    
    def calculate_auc_manual(self, y_true, y_scores):
        """Calculate AUC manually without sklearn"""
        # Sort by predicted probability
        sorted_indices = np.argsort(y_scores)[::-1]
        y_true_sorted = y_true.iloc[sorted_indices]
        
        # Calculate TPR and FPR
        tpr_list = [0]
        fpr_list = [0]
        
        num_positive = np.sum(y_true)
        num_negative = len(y_true) - num_positive
        
        tp = 0
        fp = 0
        
        for i in range(len(y_true_sorted)):
            if y_true_sorted.iloc[i] == 1:
                tp += 1
            else:
                fp += 1
            
            tpr = tp / num_positive if num_positive > 0 else 0
            fpr = fp / num_negative if num_negative > 0 else 0
            
            tpr_list.append(tpr)
            fpr_list.append(fpr)
        
        # Calculate AUC using trapezoidal rule
        auc = 0
        for i in range(1, len(fpr_list)):
            auc += (fpr_list[i] - fpr_list[i-1]) * (tpr_list[i] + tpr_list[i-1]) / 2
        
        return auc
    
    def plot_diagnostics(self):
        """Create diagnostic plots for logistic regression"""
        fig, axes = plt.subplots(2, 2, figsize=(12, 10))
        
        # Get predictions
        X_test_final = sm.add_constant(self.X_test[self.best_features])
        y_pred_proba = self.model.predict(X_test_final)
        
        # 1. Predicted probabilities distribution
        axes[0, 0].hist(y_pred_proba[self.y_test == 0], bins=30, alpha=0.5, label='Non-default', density=True)
        axes[0, 0].hist(y_pred_proba[self.y_test == 1], bins=30, alpha=0.5, label='Default', density=True)
        axes[0, 0].set_xlabel('Predicted Probability')
        axes[0, 0].set_ylabel('Density')
        axes[0, 0].set_title('Distribution of Predicted Probabilities')
        axes[0, 0].legend()
        
        # 2. Calibration plot
        n_bins = 10
        bin_edges = np.linspace(0, 1, n_bins + 1)
        bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
        
        observed_freq = []
        for i in range(n_bins):
            mask = (y_pred_proba >= bin_edges[i]) & (y_pred_proba < bin_edges[i+1])
            if np.sum(mask) > 0:
                observed_freq.append(np.mean(self.y_test[mask]))
            else:
                observed_freq.append(0)
        
        axes[0, 1].plot([0, 1], [0, 1], 'k--', label='Perfect calibration')
        axes[0, 1].plot(bin_centers, observed_freq, 'o-', label='Model calibration')
        axes[0, 1].set_xlabel('Mean Predicted Probability')
        axes[0, 1].set_ylabel('Observed Frequency')
        axes[0, 1].set_title('Calibration Plot')
        axes[0, 1].legend()
        
        # 3. ROC curve (manual)
        thresholds = np.linspace(0, 1, 100)
        tpr_list = []
        fpr_list = []
        
        for threshold in thresholds:
            y_pred = (y_pred_proba >= threshold).astype(int)
            tp = np.sum((y_pred == 1) & (self.y_test == 1))
            tn = np.sum((y_pred == 0) & (self.y_test == 0))
            fp = np.sum((y_pred == 1) & (self.y_test == 0))
            fn = np.sum((y_pred == 0) & (self.y_test == 1))
            
            tpr = tp / (tp + fn) if (tp + fn) > 0 else 0
            fpr = fp / (fp + tn) if (fp + tn) > 0 else 0
            
            tpr_list.append(tpr)
            fpr_list.append(fpr)
        
        axes[1, 0].plot(fpr_list, tpr_list, 'b-', label=f'ROC (AUC = {self.performance_metrics["AUC"]:.3f})')
        axes[1, 0].plot([0, 1], [0, 1], 'k--', label='Random')
        axes[1, 0].set_xlabel('False Positive Rate')
        axes[1, 0].set_ylabel('True Positive Rate')
        axes[1, 0].set_title('ROC Curve')
        axes[1, 0].legend()
        
        # 4. Coefficient plot
        coef_df = pd.DataFrame({
            'Variable': ['const'] + self.best_features,
            'Coefficient': self.model.params,
            'Std_Error': self.model.bse,
            'P_Value': self.model.pvalues
        })
        coef_df = coef_df[coef_df['Variable'] != 'const'].sort_values('Coefficient')
        
        axes[1, 1].barh(range(len(coef_df)), coef_df['Coefficient'])
        axes[1, 1].set_yticks(range(len(coef_df)))
        axes[1, 1].set_yticklabels(coef_df['Variable'])
        axes[1, 1].set_xlabel('Coefficient Value')
        axes[1, 1].set_title('Feature Coefficients')
        axes[1, 1].axvline(x=0, color='k', linestyle='--', alpha=0.5)
        
        plt.tight_layout()
        plt.savefig('default_prediction_diagnostics.png')
        plt.close()


class ModelValidation:
    """
    Additional validation procedures for regulatory compliance
    """
    
    @staticmethod
    def perform_stability_analysis(model_class, data, target_col, feature_cols, n_iterations=10):
        """Test model stability across different samples"""
        stability_results = {
            'coefficients': [],
            'performance': []
        }
        
        for i in range(n_iterations):
            # Create bootstrap sample
            sample_data = data.sample(n=len(data), replace=True, random_state=i)
            
            # Build model
            model = model_class(sample_data, target_col, feature_cols, random_state=i)
            model.build_model()
            
            # Store results
            if hasattr(model.model, 'params'):
                stability_results['coefficients'].append(model.model.params.to_dict())
            
            stability_results['performance'].append(model.performance_metrics)
        
        # Calculate coefficient stability
        coef_df = pd.DataFrame(stability_results['coefficients'])
        coef_stability = pd.DataFrame({
            'mean': coef_df.mean(),
            'std': coef_df.std(),
            'cv': coef_df.std() / coef_df.mean().abs()
        })
        
        # Calculate performance stability
        perf_df = pd.DataFrame(stability_results['performance'])
        perf_stability = pd.DataFrame({
            'mean': perf_df.mean(),
            'std': perf_df.std(),
            'cv': perf_df.std() / perf_df.mean().abs()
        })
        
        return coef_stability, perf_stability
    
    @staticmethod
    def perform_sensitivity_analysis(model, X_test, feature_cols):
        """Analyze model sensitivity to input changes"""
        base_predictions = model.predict(sm.add_constant(X_test))
        sensitivity_results = {}
        
        for feature in feature_cols:
            if feature in X_test.columns:
                # Create perturbed data (±10% change)
                X_test_up = X_test.copy()
                X_test_down = X_test.copy()
                
                X_test_up[feature] = X_test[feature] * 1.1
                X_test_down[feature] = X_test[feature] * 0.9
                
                # Get predictions
                pred_up = model.predict(sm.add_constant(X_test_up))
                pred_down = model.predict(sm.add_constant(X_test_down))
                
                # Calculate sensitivity
                sensitivity = np.mean(np.abs(pred_up - pred_down) / (0.2 * X_test[feature].abs().mean()))
                sensitivity_results[feature] = sensitivity
        
        return pd.Series(sensitivity_results).sort_values(ascending=False)


# Main execution function
def run_regulatory_model_framework(data_path, shadow_rating_config, default_prediction_config):
    """
    Main function to run the complete regulatory model framework
    
    Parameters:
    -----------
    data_path : str
        Path to the data file
    shadow_rating_config : dict
        Configuration for shadow rating model
        {'target_col': 'mid_pt_pd', 'feature_cols': [...]}
    default_prediction_config : dict
        Configuration for default prediction model
        {'target_col': 'default', 'feature_cols': [...]}
    """
    
    # Load data
    logging.info("Loading data...")
    data = pd.read_csv(data_path)
    
    # 1. Build Shadow Rating Model
    logging.info("="*50)
    logging.info("Building Shadow Rating Model...")
    logging.info("="*50)
    
    shadow_model = ShadowRatingModel(
        data=data,
        target_col=shadow_rating_config['target_col'],
        feature_cols=shadow_rating_config['feature_cols']
    )
    
    shadow_model.build_model()
    shadow_model.plot_diagnostics()
    shadow_model.generate_report('shadow_rating_model_report.txt')
    
    # Display model summary
    print("\nShadow Rating Model Summary:")
    print(shadow_model.model.summary())
    
    # 2. Build Default Prediction Model
    logging.info("="*50)
    logging.info("Building Default Prediction Model...")
    logging.info("="*50)
    
    default_model = DefaultPredictionModel(
        data=data,
        target_col=default_prediction_config['target_col'],
        feature_cols=default_prediction_config['feature_cols']
    )
    
    default_model.build_model()
    default_model.plot_diagnostics()
    default_model.generate_report('default_prediction_model_report.txt')
    
    # Display model summary
    print("\nDefault Prediction Model Summary:")
    print(default_model.model.summary())
    
    # 3. Perform additional validation
    logging.info("="*50)
    logging.info("Performing Model Validation...")
    logging.info("="*50)
    
    # Stability analysis for shadow rating model

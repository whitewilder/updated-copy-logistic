        st.warning("⚠️ Please save your configuration first in the Configuration page.")
    else:
        st.success("✅ Configuration loaded. Ready to run analysis.")
        
        # Display current configuration
        with st.expander("View Current Configuration"):
            st.json(st.session_state.saved_config)
        
        # Run analysis button
        if st.button("🔬 Run SFA Analysis", type="primary"):
            with st.spinner("Running SFA analysis... This may take a few minutes."):
                try:
                    # Create SfaRunSetup instance
                    config = st.session_state.saved_config
                    
                    # Map model engine string to enum
                    model_mapping = {
                        "LINEAR": RegressionModelName.LINEAR,
                        "LOGISTIC": RegressionModelName.LOGISTIC,
                        "RANDOM_FOREST": RegressionModelName.RANDOM_FOREST,
                        "GRADIENT_BOOSTING": RegressionModelName.GRADIENT_BOOSTING,
                        "XGB": RegressionModelName.XGB,
                        "NEURAL_NETWORK": RegressionModelName.NEURAL_NETWORK
                    }
                    
                    sfa_run_setup = SfaRunSetup(
                        run_parameters=SfaRunParameters(
                            process_name=config["process_name"],
                            process_name_long=config["process_name_long"],
                            model_engine=model_mapping.get(config["model_engine"], RegressionModelName.LINEAR),
                            target_transformation_metric=config["target_transformation_metric"],
                            winsorise_continuous_variables=config["winsorise_continuous_variables"],
                            outlier_detection_approach=config["outlier_detection_approach"],
                            discriminatory_power_measure=config["discriminatory_power_measure"],
                            discriminatory_power_threshold=config["discriminatory_power_threshold"],
                            no_bins_uniform=config["no_bins_uniform"],
                            output_correlation_matrix=config["output_correlation_matrix"],
                            correlation_warning_no_drivers=config["correlation_warning_no_drivers"],
                            keep_all_variables=config["keep_all_variables"],
                            save_modified_dataframe=config["save_modified_dataframe"],
                            target_variable=config["target_variable"]
                        ),
                        run_paths=SfaRunPaths(
                            data_path=config["data_path"],
                            variable_config_path=config["variable_config_path"],
                            output_directory_path=config["output_directory_path"]
                        ),
                        run_flags={
                            SfaRunFlags.sfa_univariate_distribution: config["flags"]["sfa_univariate_distribution"],
                            SfaRunFlags.sfa_univariate_discriminatory: config["flags"]["sfa_univariate_discriminatory"],
                            SfaRunFlags.sfa_univariate_sign: config["flags"]["sfa_univariate_sign"],
                            SfaRunFlags.sfa_variable_transformation: config["flags"]["sfa_variable_transformation"],
                            SfaRunFlags.sfa_bivariate_correlation: config["flags"]["sfa_bivariate_correlation"],
                            SfaRunFlags.sfa_regression: config["flags"]["sfa_regression"]
                        }
                    )
                    
                    # Run SFA
                    results = run_sfa(run_setup=sfa_run_setup)
                    
                    # Store results
                    run_info = {
                        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                        "model": config["model_engine"],
                        "target": config["target_variable"],
                        "status": "Success",
                        "output_path": config["output_directory_path"]
                    }
                    
                    st.session_state.run_history.append(run_info)
                    st.session_state.current_results = results
                    
                    st.success("✅ SFA analysis completed successfully!")
                    st.balloons()
                    
                except Exception as e:
                    st.error(f"❌ Error running SFA: {str(e)}")
                    run_info = {
                        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                        "model": config["model_engine"],
                        "target": config["target_variable"],
                        "status": "Failed",
                                         "error": str(e)
                    }
                    st.session_state.run_history.append(run_info)


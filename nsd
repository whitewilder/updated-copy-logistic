def load_sfa_results(output_path):
    """Load SFA results from output directory"""
    results = {}
    
    try:
        # Load various output files
        # Univariate results
        univariate_path = os.path.join(output_path, "univariate_analysis.csv")
        if os.path.exists(univariate_path):
            results['univariate'] = pd.read_csv(univariate_path)
        
        # Model performance
        performance_path = os.path.join(output_path, "model_performance.csv")
        if os.path.exists(performance_path):
            results['performance'] = pd.read_csv(performance_path)
        
        # Variable importance
        importance_path = os.path.join(output_path, "variable_importance.csv")
        if os.path.exists(importance_path):
            results['importance'] = pd.read_csv(importance_path)
        
        # Correlation matrix
        correlation_path = os.path.join(output_path, "correlation_matrix.csv")
        if os.path.exists(correlation_path):
            results['correlation'] = pd.read_csv(correlation_path)
        
        return results
    except Exception as e:
        st.error(f"Error loading results: {str(e)}")
        return None

def create_variable_distribution_plot(data, variable_name, target_col=None):
    """Create distribution plot for a variable"""
    fig = go.Figure()
    
    if target_col:
        # Create distribution by target
        for target_value in data[target_col].unique():
            subset = data[data[target_col] == target_value][variable_name]
            fig.add_trace(go.Histogram(
                x=subset,
                name=f"Target={target_value}",
                opacity=0.7,
                nbinsx=30
            ))
    else:
        # Single distribution
        fig.add_trace(go.Histogram(
            x=data[variable_name],
            name=variable_name,
            nbinsx=30
        ))
    
    fig.update_layout(
        title=f"Distribution of {variable_name}",
        xaxis_title=variable_name,
        yaxis_title="Frequency",
        barmode='overlay',
        height=400
    )
    
    return fig

def create_bivariate_plot(data, var1, var2, target_col=None):
    """Create bivariate analysis plot"""
    if target_col:
        fig = px.scatter(
            data,
            x=var1,
            y=var2,
            color=target_col,
            title=f"{var1} vs {var2}",
            opacity=0.6
        )
    else:
        fig = px.scatter(
            data,
            x=var1,
            y=var2,
            title=f"{var1} vs {var2}",
            opacity=0.6
        )
    
    # Add correlation line
    from scipy import stats
    slope, intercept, r_value, p_value, std_err = stats.linregress(data[var1], data[var2])
    line_x = np.array([data[var1].min(), data[var1].max()])
    line_y = slope * line_x + intercept
    
    fig.add_trace(go.Scatter(
        x=line_x,
        y=line_y,
        mode='lines',
        name=f'R² = {r_value**2:.3f}',
        line=dict(color='red', dash='dash')
    ))
    
    fig.update_layout(height=500)
    return fig

def create_model_performance_plots(performance_data):
    """Create model performance visualization plots"""
    plots = {}
    
    # ROC Curve
    if 'fpr' in performance_data and 'tpr' in performance_data:
        roc_fig = go.Figure()
        roc_fig.add_trace(go.Scatter(
            x=performance_data['fpr'],
            y=performance_data['tpr'],
            mode='lines',
            name='ROC Curve',
            line=dict(color='blue', width=2)
        ))
        roc_fig.add_trace(go.Scatter(
            x=[0, 1],
            y=[0, 1],
            mode='lines',
            name='Random',
            line=dict(color='gray', dash='dash')
        ))
        roc_fig.update_layout(
            title=f"ROC Curve (AUC = {performance_data.get('auc', 'N/A')})",
            xaxis_title="False Positive Rate",
            yaxis_title="True Positive Rate",
            height=400
        )
        plots['roc'] = roc_fig
    
    # Precision-Recall Curve
    if 'precision' in performance_data and 'recall' in performance_data:
        pr_fig = go.Figure()
        pr_fig.add_trace(go.Scatter(
            x=performance_data['recall'],
            y=performance_data['precision'],
            mode='lines',
            name='PR Curve',
            line=dict(color='green', width=2)
        ))
        pr_fig.update_layout(
            title="Precision-Recall Curve",
            xaxis_title="Recall",
            yaxis_title="Precision",
            height=400
        )
        plots['pr'] = pr_fig
    
    return plots

